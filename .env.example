# 智能座舱车载助手 - 环境变量示例
# 复制本文件为 .env.local 并按需修改

# 应用标题（显示在浏览器标签页与页眉）
VITE_APP_TITLE=智能座舱车载助手

# 默认用户名（首次进入时使用，用户可在页眉修改并持久化到 localStorage）
VITE_DEFAULT_USERNAME=车主

# 默认主题：light | dark
VITE_DEFAULT_THEME=light

# 模拟数据刷新间隔（毫秒），0 表示禁用
VITE_VEHICLE_TICK_MS=2000
VITE_SAFETY_TICK_MS=1200
VITE_WEATHER_TICK_MS=8000

# 地理定位超时（毫秒）
VITE_GEO_TIMEOUT=10000

# 天气 API 已切换为 Open-Meteo（https://open-meteo.com）
# 完全免费、无需注册、无需 API key、无调用次数限制，全球覆盖。
# 如需更换为其他天气服务，修改 src/services/weatherApi.js 即可。
